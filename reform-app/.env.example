# Googleカレンダー連携(設定すると担当者ごとのOAuth連携・FreeBusy取得・仮押さえ登録が有効になる)
# Google Cloud Console → APIとサービス → 認証情報 → OAuthクライアントID(Webアプリ)で作成し、
# 承認済みリダイレクトURIに http://localhost:3000/api/google/callback を追加する。
# Calendar API を有効化しておくこと。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 省略時は <アプリのオリジン>/api/google/callback が使われる
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# トークン保存先(省略時 .data/google-tokens.json)。DB導入までの暫定ファイル保存。
# GOOGLE_TOKEN_STORE=
